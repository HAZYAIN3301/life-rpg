  "cases": [
    {
      "id": "canOpen/allows a work purpose once an outcome is named",
      "why": "A work session must declare what it is for; that is the whole point of the gate.",
      "module": "policy",
      "fn": "canOpen",
      "state": "twoPolicies",
      "args": [
        "tiktok",
        "publish",
        {
          "expectedOutcome": "ролик опубликован"
        }
      ],
      "expect": {
        "ok": true
      }
    },
    {
      "id": "canOpen/refuses a work purpose with no outcome",
      "why": "Opening without naming the outcome would make the later honest report meaningless.",
      "module": "policy",
      "fn": "canOpen",
      "state": "twoPolicies",
      "args": [
        "tiktok",
        "publish",
        {}
      ],
      "expect": {
        "ok": false,
        "reason": "outcome_required"
      }
    },
    {
      "id": "canOpen/refuses an unknown policy",
      "why": "A native shield must not invent a rule for an app the person never chose.",
      "module": "policy",
      "fn": "canOpen",
      "state": "twoPolicies",
      "args": [
        "instagram",
        "publish",
        {
          "expectedOutcome": "x"
        }
      ],
      "expect": {
        "ok": false,
        "reason": "no_policy"
      }
    },
    {
      "id": "canOpen/refuses a purpose the person disabled",
      "why": "A disabled rule is a decision, not an omission.",
      "module": "policy",
      "fn": "canOpen",
      "state": "twoPolicies",
      "args": [
        "yt",
        "watch",
        {}
      ],
      "expect": {
        "ok": false,
        "reason": "purpose_disabled"
      }
    },
    {
      "id": "canOpen/refuses a purpose that has no rule at all",
      "why": "Absence of a rule is refused as purpose_disabled, not as no_policy.",
      "module": "policy",
      "fn": "canOpen",
      "state": "twoPolicies",
      "args": [
        "yt",
        "publish",
        {
          "expectedOutcome": "x"
        }
      ],
      "expect": {
        "ok": false,
        "reason": "purpose_disabled"
      }
    },
    {
      "id": "canOpen/refuses \"not sure why\" under control",
      "why": "\"I don't know why I'm opening this\" is exactly the entry the boundary exists for.",
      "module": "policy",
      "fn": "canOpen",
      "state": "twoPolicies",
      "args": [
        "tiktok",
        "unsure",
        {}
      ],
      "expect": {
        "ok": false,
        "reason": "unsure_in_control"
      }
    },
    {
      "id": "canOpen/refuses a topic-requiring rule with no topic",
      "why": "Research without a named topic is the shape doomscrolling takes when it wants permission.",
      "module": "policy",
      "fn": "canOpen",
      "state": "twoPolicies",
      "args": [
        "tiktok",
        "research",
        {
          "expectedOutcome": "конспект"
        }
      ],
      "expect": {
        "ok": false,
        "reason": "topic_required"
      }
    },
    {
      "id": "canOpen/allows the same rule once a topic is named",
      "why": "The refusal must be liftable by the person, not permanent.",
      "module": "policy",
      "fn": "canOpen",
      "state": "twoPolicies",
      "args": [
        "tiktok",
        "research",
        {
          "topic": "монтаж",
          "expectedOutcome": "конспект"
        }
      ],
      "expect": {
        "ok": true
      }
    },
